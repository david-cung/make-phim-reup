# Google Cloud OAuth client of type "Desktop app".
# Copy values into your local environment; do not rename this template
# to a tracked file containing real credentials.
LMT_YOUTUBE_CLIENT_ID=your-desktop-oauth-client-id.apps.googleusercontent.com

# Optional for Desktop clients that include one. Never commit a real value.
LMT_YOUTUBE_CLIENT_SECRET=your-local-client-secret
