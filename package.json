{
  "name": "local-movie-translator",
  "productName": "Local Movie Translator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Offline-first Tauri 2 desktop app that translates and dubs movies into Vietnamese entirely on-device.",
  "homepage": "https://github.com/local-movie-translator",
  "keywords": [
    "tauri",
    "offline",
    "translation",
    "movie",
    "whisper",
    "llm",
    "tts",
    "subtitles",
    "vietnamese"
  ],
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac-universal": "tauri build --target universal-apple-darwin",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
